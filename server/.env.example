# Copy to .env for local development. Railway injects these directly in
# production — never commit a filled-in .env.

# Railway provides DATABASE_URL automatically once a Postgres service is
# attached to the project. Locally this points at your own instance.
DATABASE_URL=postgres://medicross:medicross@127.0.0.1:5433/medicross

# Signs the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it logs everybody out, which is the intended emergency lever.
SESSION_SECRET=replace-me-with-32-random-bytes

# Where uploaded patient documents are written. On Railway this must be the
# mount path of a persistent volume, or files vanish on every redeploy.
STORAGE_DIR=./var/documents

# Comma-separated origins allowed to call the API with credentials. The
# marketing site needs this to POST leads from the contact forms and GDPR
# registrations. The browser's Origin header reflects the URL actually
# loaded, which is the www host after the apex's redirect — list both.
ALLOWED_ORIGINS=http://localhost:8901,https://tratamente-turcia.ro,https://www.tratamente-turcia.ro

# Cookie domain. Leave blank locally. In production set it to
# .tratamente-turcia.ro so the session is shared between the marketing site
# and the platform subdomain.
COOKIE_DOMAIN=

PORT=3000
NODE_ENV=development

# SMTP credentials for the office@tratamente-turcia.ro mailbox, used to
# e-mail completed GDPR travel-registration PDFs. Get these from wherever
# the mailbox itself is hosted (Cyberfolks, if it still is) — usually under
# something like "Email Accounts" > "Connect Devices" / "Configure Mail
# Client", which lists the exact SMTP host/port. Port 465 = implicit TLS,
# 587 = STARTTLS; either works, just match SMTP_PORT to what they give you.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=office@tratamente-turcia.ro
SMTP_PASS=
# Optional — defaults to SMTP_USER if unset.
SMTP_FROM=office@tratamente-turcia.ro

# Where completed GDPR registrations get e-mailed.
GDPR_NOTIFY_EMAIL=office@tratamente-turcia.ro
