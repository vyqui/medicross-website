# Copy to .env for local development. Railway injects these directly in
# production — never commit a filled-in .env.

# Railway provides DATABASE_URL automatically once a Postgres service is
# attached to the project. Locally this points at your own instance.
DATABASE_URL=postgres://medicross:medicross@127.0.0.1:5433/medicross

# Signs the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it logs everybody out, which is the intended emergency lever.
SESSION_SECRET=replace-me-with-32-random-bytes

# Where uploaded patient documents are written. On Railway this must be the
# mount path of a persistent volume, or files vanish on every redeploy.
STORAGE_DIR=./var/documents

# Comma-separated origins allowed to call the API with credentials. The
# marketing site needs this to POST leads from the contact forms.
ALLOWED_ORIGINS=http://localhost:8901,https://tratamente-turcia.ro

# Cookie domain. Leave blank locally. In production set it to
# .tratamente-turcia.ro so the session is shared between the marketing site
# and the platform subdomain.
COOKIE_DOMAIN=

PORT=3000
NODE_ENV=development
