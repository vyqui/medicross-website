# Generated by tools/build-htaccess.py from netlify.toml — do not edit by hand.
# Rebuild after any change to netlify.toml.

RewriteEngine On

# --- Security headers (netlify.toml [[headers]] for = "/*") ---
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Strict-Transport-Security "max-age=31536000"

# --- WordPress cutover redirect map (netlify.toml [[redirects]]) ---
# Exact rules and wildcard rules are both anchored regexes, evaluated
# in the order they appear below (same order as netlify.toml), so a
# rule never shadows one listed after it.
