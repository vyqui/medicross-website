# --- Clean URLs: serve /page from page.html without redirecting ---
# (an internal rewrite, invisible to the client — not a redirect, so
# it can't loop against the rule below the way a public 200/301 pair
# did on Cloudflare; see git history on that host's config.)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html [L]

# The reverse direction: a request for the literal .html file redirects
# to the extensionless URL, so every canonical tag on the site (all of
# them extensionless) matches what is actually served.
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# --- Custom 404 ---
ErrorDocument 404 /404.html

